# Copy to .env and fill in to run against live data instead of the bundled
# sample dataset. Without these, `npm start` still runs using data/sample-input.json.
# .env is loaded automatically (via dotenv, see src/env.js) — no need to
# export these in your shell yourself. .env is gitignored — never commit it.

# GOOGLE_PLACES_API_KEY is NOT set here — as of 2026-08-17 it lives only in
# Supabase's Function secrets, read by the `places-search` Edge Function
# (see supabase/functions/places-search/index.ts). This pipeline calls that
# function instead of Google directly, so it needs these three instead:

# Safe to share — the project's URL and legacy anon key, same public,
# RLS-scoped key already embedded in the Flutter app. Required because
# Supabase Edge Functions only verify_jwt against the legacy anon/
# service_role JWT keys, not the newer sb_publishable_/sb_secret_ format.
SUPABASE_URL=https://aesorixtfasfuvcqrvem.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFlc29yaXh0ZmFzZnV2Y3FydmVtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY3MTYxMjcsImV4cCI6MjEwMjI5MjEyN30.3zOZdQtis-p_iBNQmWeLipv-g7MbnSVK2BoBDbTGp0c

# A REAL secret, unlike the two above — generated locally, matched against
# the same value set as a Supabase Function secret. Without this, anyone
# who extracted the app's public anon key could call places-search and run
# up Caelan's Google Places bill; verify_jwt alone doesn't stop that since
# the anon key is meant to be public. Never commit this.
PIPELINE_SHARED_SECRET=

# Paused 2026-08-17 — Yelp Fusion no longer has a permanent free tier (30-day
# trial, then paid per-call plans). Caelan decided to run v1 on Google Places
# only. yelp.js is kept dormant (never wired into pipeline.js) in case this
# gets revisited.
YELP_API_KEY=

# Not called by the main pipeline anymore — Popular Times was dropped as a
# signal on 2026-08-15 (confirmed 0/100 Sydney restaurants had popular_times
# data via Outscraper). Only used by scripts/check-outscraper-coverage.mjs,
# kept around in case this gets revisited.
OUTSCRAPER_API_KEY=

# Supabase — direct Postgres connection as the pipeline_service role (see
# supabase/migrations/0002_pipeline_role.sql), NOT the service_role key.
# pipeline_service is scoped by GRANT + RLS to read/write restaurants and
# read-only mic_readings — nothing else in the database.
SUPABASE_DB_URL=postgresql://pipeline_service:<password>@db.<project-ref>.supabase.co:5432/postgres
