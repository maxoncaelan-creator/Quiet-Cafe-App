# Copy to .env and fill in to run against live data instead of the bundled
# sample dataset. Without these, `npm start` still runs using data/sample-input.json.
# .env is loaded automatically (via dotenv, see src/env.js) — no need to
# export these in your shell yourself. .env is gitignored — never commit it.

GOOGLE_PLACES_API_KEY=
YELP_API_KEY=

# Not called by the main pipeline anymore — Popular Times was dropped as a
# signal on 2026-08-15 (confirmed 0/100 Sydney restaurants had popular_times
# data via Outscraper). Only used by scripts/check-outscraper-coverage.mjs,
# kept around in case this gets revisited.
OUTSCRAPER_API_KEY=

# Supabase — direct Postgres connection as the pipeline_service role (see
# supabase/migrations/0002_pipeline_role.sql), NOT the service_role key.
# pipeline_service is scoped by GRANT + RLS to read/write restaurants and
# read-only mic_readings — nothing else in the database.
SUPABASE_DB_URL=postgresql://pipeline_service:<password>@db.<project-ref>.supabase.co:5432/postgres
