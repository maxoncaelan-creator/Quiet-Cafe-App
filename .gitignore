# Repo-wide safety net, in addition to the nested .gitignore files under
# stages/03_build/output/{data-pipeline,app}/. Never commit secrets.
**/.env
!**/.env.example
**/node_modules/

# Marketing site build output. Generated by marketing-site/build.js, and it
# contains the injected Supabase config — src/ is the source of truth.
stages/03_build/output/marketing-site/dist/

# OS/editor cruft
.DS_Store
Thumbs.db
